# =================================================================
# ScamShield Backend Environment Configuration
# =================================================================

# Database Configuration (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./scamshield.db
# DATABASE_URL=postgresql://scamshield:scamshield_secure_pass@localhost:5432/scamshield

# Authentication & Access Control (Single-User Self-Host)
AUTH_ENABLED=false
SECRET_KEY=generate_a_random_32_byte_hex_key_for_production
CORS_ORIGINS=["*"]
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=10

# AI / Large Language Model Engine (mock, gemini, openai, local)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Threat Intelligence & Reputation Providers (Optional)
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
WHOIS_API_KEY=

# OCR and Speech Processing
OCR_PROVIDER=tesseract
OCR_API_KEY=
STT_PROVIDER=mock
STT_API_KEY=

# Detection Thresholds
RISK_THRESHOLD_SAFE=29
RISK_THRESHOLD_SUSPICIOUS=69
RISK_THRESHOLD_SCAM=70
